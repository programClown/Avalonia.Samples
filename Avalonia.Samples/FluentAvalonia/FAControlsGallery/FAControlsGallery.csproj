<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Pages\SampleCode\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3"/>
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0"/>
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0"/>
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.0-preview2" />
  </ItemGroup>
</Project>
